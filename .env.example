# Discord Bot Token (Developer Portal > Applications > Bot > Token)
BOT_TOKEN=your_bot_token_here

# Kaynak (Yedeği Alınacak / Kopyalanacak) Sunucunun ID'si
SOURCE_GUILD_ID=000000000000000000

# Hedef (Aktarılacak) Sunucunun ID'si
TARGET_GUILD_ID=000000000000000000

# Klonlama öncesi hedef sunucudaki mevcut kanal ve rolleri temizlesin mi?
# true  -> Hedefteki tüm silinebilir kanal ve rolleri siler, sıfırdan kurar (DİKKATLİ KULLANIN).
# false -> Hedeftekileri silmez, eksik olanları ekler ve eşleşenleri günceller.
CLEAN_TARGET_FIRST=false
